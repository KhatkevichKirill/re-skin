# Keep the Docker build context small — never ship runtime data, secrets, or VCS.
.git
.gitignore
data/
secrets/
*.env
.env
.env.*
**/__pycache__/
*.pyc
*.pyo
*.mp4
*.mov
*.jpg
*.jpeg
*.png
.venv/
venv/
node_modules/
*.db
*.db-wal
*.db-shm
tasks/
docs/
# AICP-297: the importer verifies this frozen manifest by sha256 (backend/Dockerfile copies it).
!docs/knowledge/holdout-manifest-v1.json
scripts/e2e_*.py
