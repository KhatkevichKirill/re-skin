# ============================================================
# re-skin — environment template (safe to commit)
# Copy to .env and fill in real values.
# ============================================================

# --- kie.ai (Seedance) ---
KIE_API_KEY=

# --- kie.ai image-to-image (Run reference preprocessing + per-segment regen) ---
# Which GPT Image variant transforms reference images before they reach the
# video model. All three below take a byte-identical request and return a
# byte-identical response, so switching needs no rebuild, no migration and no
# code change — only an edit here plus `docker compose up -d --scale worker=2`,
# which RECREATES the containers. `docker compose restart` does NOT re-read
# this file: env_file is baked in at creation (verified 2026-09-12). Then
# `docker compose restart nginx`, as after every up -d.
# Measured live 2026-09-12: every variant costs
# 6 credits at 1K; 2.5 came back in 71-88s against gpt-image-2's ~100s.
#   gpt-image-2-5-flare-image-to-image      (default) OpenAI's own default
#   gpt-image-2-5-sunburst-image-to-image   same price, "most capable"
#   gpt-image-2-image-to-image              pre-2026-09 model; rollback
KIE_IMAGE_MODEL=gpt-image-2-5-flare-image-to-image
# 1K | 2K | 4K. 1K (6 credits) is what every run to date has used; on a 9:16
# frame it returns 941px wide — BELOW a 1080p source. 2K (10 credits) returns
# 1536x2736. 2K with aspect_ratio=auto is a create-failure on gpt-image-2 and
# only became legal with 2.5, so do not raise this while rolled back.
KIE_IMAGE_RESOLUTION=1K

# --- Google Drive (service account) ---
# Place service-account JSON at the path below; SA needs write access to target folder(s).
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/gdrive-sa.json
GDRIVE_DEFAULT_FOLDER_ID=
# Folder where DB backups are uploaded by scripts/backup_db.sh (share it with the SA).
GDRIVE_BACKUP_FOLDER_ID=

# --- Google Sheets: "Final Creatives" export (reuses the SA above) ---
# Share the spreadsheet with the service-account email as Editor.
FINAL_CREATIVES_SPREADSHEET_ID=
FINAL_CREATIVES_TAB=Final Creatives

# --- Web access (Nginx basic auth) ---
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
APP_EXTERNAL_PORT=8847

# --- Public links (/public/..., unauthenticated, HMAC-signed; AICP-151) ---
# REQUIRED for any /public link to work. No fallback to BASIC_AUTH_PASS: unset
# or shorter than 32 chars -> /public/* returns 503 and no token is minted
# (the rest of the app still runs). Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Changing it invalidates every link already handed out.
PUBLIC_LINK_SECRET=
# Optional rotation grace period: comma-separated OLD secrets whose tokens are
# still accepted (verify-only, never used to mint). Leave empty = no transition.
PUBLIC_LINK_SECRET_PREVIOUS=

# --- Infra ---
# Set a strong password (e.g. `openssl rand -hex 24`) and reference it in REDIS_URL.
REDIS_PASSWORD=
REDIS_URL=redis://:REDIS_PASSWORD@redis:6379/0

# --- PostgreSQL (production) ---
# Generate a strong password: openssl rand -hex 24
# These are consumed by the `db` service in docker-compose.yml.
POSTGRES_USER=reskin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=reskin

# DATABASE_URL for Postgres (set this when cutting over from SQLite):
#DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# DATABASE_URL for SQLite (default — keep for local dev / tests):
DATABASE_URL=sqlite:///./data/app.db

# --- App config ---
DEFAULT_RESOLUTION=720p          # default for new runs; 480p = test tier (AICP-391)
MAX_REFERENCE_IMAGES=5           # UI cap (Seedance allows up to 9, Gemini Omni up to 7)
# SEGMENT_MAX_SECONDS was removed. Max swap-segment length is no longer a
# global env knob — it is set per project (the "Max segment length" control on
# the New Project form / Project settings). Unset means 10s, the smallest
# per-clip ceiling across all models, so the project runs on any of them.
# Raising it to 15s (Seedance 2.0/2.5) or 30s (Seedance 2.5 only) trades model
# portability for fewer stitch seams — see wiki/models/ai-models.md.

# Upload and worker throughput controls
# Keep MAX_UPLOAD_SIZE_MB <= deploy/nginx/nginx.conf client_max_body_size.
MAX_UPLOAD_SIZE_MB=1024
SUBMIT_CONCURRENCY=2
STITCH_CUT_CONCURRENCY=2
PROCESS_JOB_TIMEOUT=10800

# Delivery size cap (decimal MB) for every video uploaded to Drive. The final
# encode is CRF-driven with an x264 VBV cap sized from the output duration, so
# a file that fits at CRF quality keeps that quality and only harder content
# gets held down to the budget. 0 disables the cap.
DELIVERY_MAX_SIZE_MB=100
DELIVERY_CRF=20
DELIVERY_PRESET=fast

# --- Localisation (see docs/localisation.md) ---
# Both models are reached through KIE_API_KEY above, on two DIFFERENT kie.ai
# routes: the transcriber on the OpenAI-compatible
# https://api.kie.ai/{model}/v1/chat/completions (model is a URL path segment,
# so it must be a valid kie.ai model slug) and the translator on the Responses
# API https://api.kie.ai/codex/v1/responses (model travels in the body).
LOCALISATION_TRANSCRIBE_MODEL=gemini-2.5-pro
# Comma-separated, tried in order when the transcribe model is unavailable
# (kie.ai 5xx/"being maintained" after retries, or 422 not supported).
# Empty disables.
LOCALISATION_TRANSCRIBE_FALLBACK_MODELS=gemini-3.1-pro,gemini-3-5-flash-openai
LOCALISATION_TRANSLATE_MODEL=gpt-6-1-sol
# Tried in order when the translate model is unavailable. Empty disables.
LOCALISATION_TRANSLATE_FALLBACK_MODELS=gpt-5-6-luna
LOCALISATION_TRANSLATE_EFFORT=high
# Translate-call timeout; keep it well under nginx's 300s proxy_read_timeout.
LOCALISATION_TRANSLATE_TIMEOUT_SEC=90
# Max hook stills sent to the translator (0 disables).
LOCALISATION_TRANSLATE_FRAMES=8
# Default length of the re-spoken hook, in seconds, for localisation projects
# that leave "hook_sec" empty. Read at analyze time.
LOCALISATION_DEFAULT_HOOK_SEC=10
# Per-request timeout for the two LLM calls (the transcriber has to fetch and
# decode the uploaded clip before it answers).
LOCALISATION_TIMEOUT_SEC=600

# BytePlus ModelArk — second generation provider (Seedance video + Seedream images).
# See wiki/decisions/byteplus-second-provider.md. Models must be activated
# per-account in the Ark Console before any call succeeds (ModelNotOpen).
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# --- Fal, the RESERVE provider (AICP-312 Stage 1 / AICP-330) ---
# docs/fal-provider-design.md §9. API-scoped key only (never an ADMIN key).
# FAL_ENABLED gates ADMISSION only; existing tasks keep being polled and
# recovered by the fal-worker while the key is present. FAL_PROJECT_IDS is an
# explicit comma-separated allowlist (empty = no project). Other FAL_* tunables
# and their validated bounds are in backend/app/config.py.
FAL_API_KEY=
FAL_ENABLED=false
FAL_PROJECT_IDS=
