# ============================================================
# re-skin — environment template (safe to commit)
# Copy to .env and fill in real values.
# ============================================================

# --- kie.ai (Seedance) ---
KIE_API_KEY=

# --- Google Drive (service account) ---
# Place service-account JSON at the path below; SA needs write access to target folder(s).
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/gdrive-sa.json
GDRIVE_DEFAULT_FOLDER_ID=

# --- Web access (Nginx basic auth) ---
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
APP_EXTERNAL_PORT=8847

# --- Infra ---
# Set a strong password (e.g. `openssl rand -hex 24`) and reference it in REDIS_URL.
REDIS_PASSWORD=
REDIS_URL=redis://:REDIS_PASSWORD@redis:6379/0

# --- PostgreSQL (production) ---
# Generate a strong password: openssl rand -hex 24
# These are consumed by the `db` service in docker-compose.yml.
POSTGRES_USER=reskin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=reskin

# DATABASE_URL for Postgres (set this when cutting over from SQLite):
#DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# DATABASE_URL for SQLite (default — keep for local dev / tests):
DATABASE_URL=sqlite:///./data/app.db

# --- App config ---
DEFAULT_RESOLUTION=480p
MAX_REFERENCE_IMAGES=2
# Seedance per-clip ceiling for the LEGACY v1 pipeline only. The v2 path takes
# its segmentation cap from the project instead (VideoProject.max_segment_sec,
# settable on the create form and the project page); NULL there means the
# smallest per-clip ceiling across every model in app/ai_models.py, so the
# segmentation stays runnable on any of them.
SEGMENT_MAX_SECONDS=15

# Subtitle-removal projects cut on scene changes instead of detected faces.
# Minimum scene length in seconds (PySceneDetect --min-scene-len).
SCENE_MIN_LEN_SECONDS=4

# --- Localisation (docs/localisation.md) ---
# Both LLM calls go to kie.ai on the existing KIE_API_KEY — no new vendor.
# Transcription needs a VIDEO-capable model (it is handed the source clip by
# URL); translation is text-only and runs on the Responses route.
LOCALISATION_TRANSCRIBE_MODEL=gemini-2.5-pro
LOCALISATION_TRANSLATE_MODEL=gpt-5-6-luna
# Hook length used when a project leaves it unset. Consumed at analyze time.
LOCALISATION_DEFAULT_HOOK_SEC=10
# Per-request timeout for both calls — transcribing a video is slow, and the
# shared client's 60s default is far too tight.
LOCALISATION_TIMEOUT_SEC=600

# Upload and worker throughput controls
# Keep MAX_UPLOAD_SIZE_MB <= deploy/nginx/nginx.conf client_max_body_size.
MAX_UPLOAD_SIZE_MB=1024
SUBMIT_CONCURRENCY=2
STITCH_CUT_CONCURRENCY=2
PROCESS_JOB_TIMEOUT=10800
